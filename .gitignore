# Uploaded files (keep the dir structure via .gitkeep, ignore uploads)
web/static/uploads/*
!web/static/uploads/.gitkeep

# Nested subdirectories (uploads/pemetik/, uploads/future/)
web/static/uploads/*/*
!web/static/uploads/*/.gitkeep
